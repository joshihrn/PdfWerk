*.md
!README.md
.vs/
.vscode/
.idea/
*.db
*.user

# SQLite writes these beside the database while a server is running, and removes them
# when it stops. A build started during development would otherwise fail on a file that
# existed when the context was listed and was gone by the time it was read.
*.db-shm
*.db-wal

# Test output. The Playwright report alone is tens of megabytes of screenshots and traces, none
# of which the image needs, and all of which has to be uploaded before a build can start.
e2e/playwright-report/
e2e/test-results/
e2e/.artifacts/
e2e/demo-output/
