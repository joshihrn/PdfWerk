# Copy to .env before running docker compose up.

# Required. Any strong random value.
POSTGRES_PASSWORD=change-me

# Required. Salts the hash of anonymous callers' IP addresses, so the rate-limit store never
# holds anything reversible. Generate one with: openssl rand -hex 32
ADDRESS_SALT=change-me

# Optional. Summarisation is the only feature that needs one.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=gemini
