{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Client": {
    "TrustForwardedHeaders": false,
    "AddressSalt": ""
  },

  "LibreOffice": {
    "Enabled": true,
    "ExecutablePath": "",
    "TimeoutSeconds": 90
  },

  "RateLimits": {
    "Enabled": true,
    "FailClosed": true,
    "KeyPrefix": "pdfwerk:rl"
  }
}
